       // Base class

class Animal {
String name;
Animal(String name) {
this.name = name;

    }

void eat() {
System.out.println(name + " is eating.");
    }
}

      // derived base class   with (extends) keyword   
class Dog extends Animal {
Dog(String name) {
super(name); 
    }

}


       // Main class
public class InheritanceDemo {
public static void main(String[] args) {
Dog myDog = new Dog("Buddy");
myDog.eat(); 
       }
}
