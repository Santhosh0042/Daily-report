     // Creating Abstract Class

abstract class Vehicle { 
abstract void start();
abstract void stop();
}

// extends Abstract class

class Car extends Vehicle {

void start() {
System.out.println("Car starts with key");
    }

void stop() {
System.out.println("Car is stopping");
    }
}

// Main class

public class Main {
public static void main(String[] args) {
Vehicle obj = new Car();  
obj.start();
obj.stop();
    }
}
