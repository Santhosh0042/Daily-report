class Car {

String brand;
String model;
int year;

    // Constructor


Car(String brand, String model, int year) {
this.brand = brand;
this.model = model;
this.year = year;
    }

void displayDetails() {
System.out.println("Car Brand : " + brand);
System.out.println("Car Model : " + model);
System.out.println("Year      : " + year);
    }
}

public class Main {
public static void main(String[] args) {

Car car1 = new Car("Mahindra", "BE6", 2025);
car1.displayDetails();
    }
}
