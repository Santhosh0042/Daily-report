class Student {

    String name;
    int rollNo;
    double marks;

    // Constructor
    
    Student(String name, int rollNo, double marks) {
    this.name = name;
    this.rollNo = rollNo;
    this.marks = marks;
    
    }

    void displayDetails() {
        System.out.println("Name    : " + name);
        System.out.println("Roll No : " + rollNo);
        System.out.println("Marks   : " + marks);
    }
}

public class Main {
    public static void main(String[] args) {

        // Creating object using constructor
        
        Student s1 = new Student("Ram", 15, 64.5);
        Student s2 = new Student("Ravi", 25, 75);
        
        
        s1.displayDetails();
        
        System.out.println("---------------------");
        
        s2.displayDetails();    
      
    }
    
}
