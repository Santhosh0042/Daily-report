 // Base class

class Animal {
  
void sound() {
System.out.println("Animal makes sound");
    }
}

  // extends class
class Dog extends Animal {
void bark() {
System.out.println("Dog barks");
    }
}

  // Main class
public class InheritanceExample {
public static void main(String[] args) {
Dog d = new Dog();
d.sound();  
d.bark();
    }
}
