// Base class


class Vehicle {
void start() {
System.out.println("Vehicle is starting...");
    }
}

// derived class


class Car extends Vehicle {
void drive() {
System.out.println("Car is driving...");
    }
}

// Main class


public class InheritanceExample2 {
public static void main(String[] args) {

Car c = new Car();

c.start();   
c.drive();   
    }
}
